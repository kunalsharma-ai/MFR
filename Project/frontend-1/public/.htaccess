# MyFrequentRewards — Apache config (copied to dist/ on build)
Options -MultiViews
RewriteEngine On

# Force HTTPS + www (adjust if you prefer the apex domain)
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTP_HOST} ^myfrequentrewards\.com$ [NC]
RewriteRule ^ https://www.myfrequentrewards.com%{REQUEST_URI} [L,R=301]

# /how-it-works  ->  /how-it-works/index.html (prerendered page)
DirectorySlash Off
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
RewriteRule ^(.+?)/?$ $1/index.html [L]

# Anything else that doesn't exist -> real 404 page
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|webp|png|jpg|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
