# MyFrequentRewards — Apache config (copied to dist/ on build)
Options -MultiViews
RewriteEngine On

# Force HTTPS + www (adjust if you prefer the apex domain)
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTP_HOST} ^myfrequentrewards\.com$ [NC]
RewriteRule ^ https://www.myfrequentrewards.com%{REQUEST_URI} [L,R=301]

# /how-it-works  ->  /how-it-works/index.html (prerendered page)
DirectorySlash Off
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
RewriteRule ^(.+?)/?$ $1/index.html [L]

# Anything else that doesn't exist -> real 404 page
ErrorDocument 404 /404.html

# v3.1 speed: serve the pre-compressed copies written by the build (file.br / file.gz) — smaller than on-the-fly
# compression and zero CPU. Falls back to mod_deflate when a copy is missing.
<IfModule mod_rewrite.c>
  RewriteCond %{HTTP:Accept-Encoding} br
  RewriteCond %{REQUEST_FILENAME}.br -f
  RewriteRule ^(.+)\.(html|js|css|svg|json|txt|xml)$ $1.$2.br [L,E=no-gzip:1]
  RewriteCond %{HTTP:Accept-Encoding} gzip
  RewriteCond %{REQUEST_FILENAME}.gz -f
  RewriteRule ^(.+)\.(html|js|css|svg|json|txt|xml)$ $1.$2.gz [L,E=no-gzip:1]
  # (clean URLs are rewritten to /path/index.html first, then the rules above pick its .br copy)
  RewriteCond %{HTTP:Accept-Encoding} br
  RewriteCond %{DOCUMENT_ROOT}/index.html.br -f
  RewriteRule ^$ index.html.br [L,E=no-gzip:1]
</IfModule>
<FilesMatch "\.html\.br$">
  ForceType text/html
</FilesMatch>
<FilesMatch "\.js\.br$">
  ForceType text/javascript
</FilesMatch>
<FilesMatch "\.css\.br$">
  ForceType text/css
</FilesMatch>
<FilesMatch "\.svg\.br$">
  ForceType image/svg+xml
</FilesMatch>
<FilesMatch "\.html\.gz$">
  ForceType text/html
</FilesMatch>
<FilesMatch "\.js\.gz$">
  ForceType text/javascript
</FilesMatch>
<FilesMatch "\.css\.gz$">
  ForceType text/css
</FilesMatch>
<IfModule mod_headers.c>
  <FilesMatch "\.br$">
    Header set Content-Encoding br
    Header append Vary Accept-Encoding
  </FilesMatch>
  <FilesMatch "\.gz$">
    Header set Content-Encoding gzip
    Header append Vary Accept-Encoding
  </FilesMatch>
</IfModule>
# never compress the pre-compressed copies a second time
<FilesMatch "\.(br|gz)$">
  SetEnv no-gzip 1
</FilesMatch>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml text/plain application/xml
</IfModule>

<IfModule mod_headers.c>
  # hashed build files never change → cache for a year
  <If "%{REQUEST_URI} =~ m#^/(assets|fonts)/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <ElseIf "%{REQUEST_URI} =~ m#\.(webp|png|jpg|svg|ico)$#">
    Header set Cache-Control "public, max-age=2592000"
  </ElseIf>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
