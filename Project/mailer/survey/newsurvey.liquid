    </table>
  </td>
</tr>

<tr>
  <td
    align="center"
    style="
      padding: 35px 20px 18px;
    "
  >
    <p
      style="
        margin: 0;
        color: #333333;
        font-size: 17px;
      "
    >
      With Warm Regards,
    </p>

    <p
      style="
        margin: 10px 0;
