{%- comment -%}
  Member engagement emails (weekly summary, points expiry, guardian approvals): shared top. Set before including:
    tone      "teen" (violet / pink) or anything else (MFR navy / orange)
    preheader the short line inbox apps show after the subject
    kicker    small label above the title
    title     the headline
  Data from api/app/engagement/mail.js: subject, site, support.email, support.phone, year, template, links.unsubscribe.
{%- endcomment -%}
{%- if tone == "teen" -%}
  {%- assign c_bar = "#7c3aed" -%}{%- assign c_bar2 = "#ff3da5" -%}{%- assign c_hero = "#f6f0ff" -%}{%- assign c_kick = "#7c3aed" -%}{%- assign c_ink = "#1d1440" -%}
{%- else -%}
  {%- assign c_bar = "#0b2a6b" -%}{%- assign c_bar2 = "#fe7e00" -%}{%- assign c_hero = "#f3f6fc" -%}{%- assign c_kick = "#0b5bd3" -%}{%- assign c_ink = "#14213d" -%}
{%- endif -%}
<!doctype html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="x-apple-disable-message-reformatting" />
  <meta name="color-scheme" content="light only" />
  <title>{{ subject }}</title>
  <style>
    @media (max-width: 620px) {
      .w { width: 100% !important; }
      .px { padding-left: 22px !important; padding-right: 22px !important; }
      .h1 { font-size: 24px !important; line-height: 31px !important; }
      .btn-row td.btn-cell { display: block !important; width: 100% !important; padding: 0 0 12px 0 !important; }
      .btn-row a { display: block !important; }
    }
  </style>
</head>
<body style="margin:0;padding:0;background:#eef1f7;">
<div style="display:none;max-height:0;overflow:hidden;opacity:0;color:transparent;mso-hide:all;">{{ preheader }}&#8199;&#65279;&#847;&#8199;&#65279;&#847;&#8199;&#65279;&#847;&#8199;&#65279;&#847;</div>
<table role="presentation" width="100%" border="0" cellspacing="0" cellpadding="0" bgcolor="#eef1f7" style="background:#eef1f7;font-family:Arial,Helvetica,sans-serif;">
  <tr>
    <td align="center" style="padding:24px 12px;">
      <table role="presentation" class="w" width="600" border="0" cellspacing="0" cellpadding="0" bgcolor="#ffffff" style="width:600px;max-width:600px;background:#ffffff;border-radius:18px;overflow:hidden;">
        <tr><td height="8" bgcolor="{{ c_bar }}" style="font-size:0;line-height:0;background:{{ c_bar }};">&nbsp;</td></tr>
        <tr>
          <td align="center" style="padding:24px 24px 18px;">
            <img src="https://www.myfrequentrewards.com/images/logo/mfr-logo.png" alt="MyFrequentRewards" width="260" style="display:block;max-width:260px;width:100%;height:auto;border:0;" />
          </td>
        </tr>
        <tr><td height="3" bgcolor="{{ c_bar2 }}" style="font-size:0;line-height:0;background:{{ c_bar2 }};">&nbsp;</td></tr>
        <tr>
          <td class="px" bgcolor="{{ c_hero }}" style="padding:34px 44px 28px;background:{{ c_hero }};">
            <p style="margin:0 0 10px;font-size:12px;line-height:16px;letter-spacing:1.4px;text-transform:uppercase;font-weight:bold;color:{{ c_kick }};">{{ kicker }}</p>
            <h1 class="h1" style="margin:0;font-size:28px;line-height:36px;font-weight:bold;color:{{ c_ink }};">{{ title }}</h1>
          </td>
        </tr>
        <tr>
          <td class="px" style="padding:28px 44px 8px;font-size:16px;line-height:26px;color:#3a4256;">
