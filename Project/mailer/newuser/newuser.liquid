<table
  width="100%"
  border="0"
  cellspacing="0"
  cellpadding="0"
  bgcolor="#f4f4f4"
  style="
    margin: 0;
    padding: 0;
    background: #f4f4f4;
    font-family: Arial, Helvetica, sans-serif;
  "
>
  <tr>
    <td align="center">
      <table
        width="920"
        border="0"
        cellspacing="0"
        cellpadding="0"
        bgcolor="#ffffff"
        style="max-width: 920px"
      >
        <!-- TOP BORDER -->
        <tr>
          <td height="12" bgcolor="#002b8f"></td>
        </tr>

        <!-- LOGO SECTION -->
        <tr>
          <td align="center" style="padding: 30px 20px; background: #ffffff">
            <img
              src="https://myfrequentrewards.com/images/logo/mfr-logo.png"
              alt="MyFrequentRewards"
              width="520"
              style="display: block; max-width: 100%"
            />
          </td>
        </tr>

        <tr>
          <td height="1" bgcolor="#fe7e00"></td>
        </tr>

        <!-- INTRO -->
        <tr>
          <td style="padding: 35px 60px 15px">
            <p
              style="
                margin: 0 0 25px;
                font-size: 28px;
                color: #0d2372;
                font-weight: bold;
              "
            >
              Hello Admin,
            </p>

            <p
              style="
                margin: 0;
                font-size: 22px;
                line-height: 38px;
                color: #14245d;
              "
            >
              A new user has successfully registered on the
              MyFrequent<span style="color: #fe7e00">Rewards</span>
              panel.
            </p>
          </td>
        </tr>

        <!-- USER REGISTRATION CARD -->
        <tr>
          <td style="padding: 30px 55px">
            <table
              width="100%"
              border="0"
              cellspacing="0"
              cellpadding="0"
              style="
                border: 1px solid #d7e4ff;
                border-radius: 12px;
                background: #f8fbff;
              "
            >
              <tr>
                <td width="220" align="center">
                  <img
                    src="https://frequentresearch.com/mailer/mail-icons/mfr/mail.png"
                    width="180"
                    alt="New Registration"
                  />
                </td>

                <td style="padding: 35px 35px 35px 0">
                  <h2
                    style="
                      margin: 0 0 15px;
                      color: #0d2372;
                      font-size: 30px;
                    "
                  >
                    New User Registration
                  </h2>

                  <p
                    style="
                      margin: 0 0 20px;
                      color: #17285f;
                      font-size: 20px;
                      line-height: 34px;
                    "
                  >
                    A new panelist has registered successfully. The
                    registration details available in this notification are
                    listed below.
                  </p>

                  <table
                    width="100%"
                    border="0"
                    cellspacing="0"
                    cellpadding="0"
                    style="
                      font-size: 18px;
                      line-height: 32px;
                      color: #22305f;
                    "
                  >
                    <tr>
                      <td
                        width="130"
                        style="
                          font-weight: bold;
                          color: #0d2372;
                          padding-bottom: 8px;
                        "
                      >
                        Name
                      </td>
                      <td style="padding-bottom: 8px">
                        {{user.name.first}}
                      </td>
                    </tr>

                    <tr>
                      <td
                        style="
                          font-weight: bold;
                          color: #0d2372;
                          padding-bottom: 8px;
                        "
                      >
                        User ID
                      </td>
                      <td style="padding-bottom: 8px">
                        {{user._id}}
                      </td>
                    </tr>

                    <tr>
                      <td
                        style="
                          font-weight: bold;
                          color: #0d2372;
                        "
                      >
                        Panel
                      </td>
                      <td>
                        MyFrequentRewards
                      </td>
                    </tr>
                  </table>
                </td>
              </tr>
            </table>
          </td>
        </tr>

        <!-- ADMIN NOTICE -->
        <tr>
          <td style="padding: 0 55px 35px">
            <table
              width="100%"
              style="
                background: #fef8f2;
                border: 1px solid #f0d7b4;
                border-radius: 10px;
              "
            >
              <tr>
                <td width="120" align="center" style="padding: 25px">
                  <img
                    src="https://frequentresearch.com/mailer/mail-icons/mfr/shield.png"
                    width="85"
                    alt="Notification"
                  />
                </td>

                <td style="padding: 25px 25px 25px 0">
                  <h3
                    style="
                      margin: 0 0 10px;
                      color: #0d2372;
                      font-size: 22px;
                    "
                  >
                    Registration Notification
                  </h3>

                  <p
                    style="
                      margin: 0;
                      font-size: 18px;
                      line-height: 30px;
                      color: #22305f;
                    "
                  >
                    This notification has been generated automatically after
                    a new user registration. Please review the user's account
                    in the admin panel if any further action is required.
                  </p>
                </td>
              </tr>
            </table>
          </td>
        </tr>

        {% include "mailer/footer.liquid" %}
      </table>
    </td>
  </tr>
</table>

