{%- comment -%} Set btn_url and btn_label before including. {%- endcomment -%}
<table role="presentation" border="0" cellspacing="0" cellpadding="0" align="center" style="margin:22px auto 6px;">
  <tr>
    <td align="center" bgcolor="{{ brand.primary }}" style="border-radius:12px;background:{{ brand.primary }};background-image:linear-gradient(135deg,{{ brand.light }},{{ brand.primary }});">
      <a class="btn" href="{{ btn_url }}" style="display:inline-block;padding:15px 30px;font-size:16px;line-height:20px;font-weight:700;color:#ffffff;text-decoration:none;border-radius:12px;">{{ btn_label }} &rarr;</a>
    </td>
  </tr>
</table>
