{%- assign tone = "guardian" -%}
{%- capture preheader -%}{% if stage == "decision" %}{{ teen.firstName }}'s request is waiting for your yes or no.{% else %}{{ teen.firstName }}'s registration is waiting for you to finish.{% endif %}{%- endcapture -%}
{%- assign kicker = "Reminder for parents and legal guardians" -%}
{%- capture title -%}{% if stage == "decision" %}{{ teen.firstName }}'s request is waiting for you{% else %}A step is left for {{ teen.firstName }}'s registration{% endif %}{%- endcapture -%}
{% include "mailer/teen/_head.liquid" %}
<p style="margin:0 0 16px;">Hello {{ guardian.firstName }},</p>
{% if stage == "decision" %}
<p style="margin:0 0 6px;">{{ teen.firstName }} asked to join the MyFrequentRewards Teen Panel and named you as their {{ guardian.relationLabel | downcase }}. Nothing happens unless you say yes.</p>
<p style="margin:12px 0 6px;font-size:18px;line-height:26px;font-weight:bold;color:#14213d;">Do you want to enroll {{ teen.firstName }} in the Teen Panel?</p>
{% include "mailer/teen/_yesno.liquid" %}
{% else %}
<p style="margin:0 0 16px;">Thank you for saying yes. {% if stage == "consent" %}Your consent selections are the last step.{% else %}A short form about you and your consent selections are left.{% endif %} {{ teen.firstName }}'s account stays switched off until they're done.</p>
{%- assign btn_url = links.review -%}{%- assign btn_label = "Continue where I left off" -%}{%- assign btn_color = "#0b5bd3" -%}
{%- capture btn_note -%}This link works until {{ expires | date: "%B %-d, %Y" }}.{%- endcapture -%}
{% include "mailer/teen/_button.liquid" %}
{% endif %}
<p style="margin:0 0 4px;font-size:13px;line-height:20px;color:#7b8399;">Reminder {{ count }} of 3. We won't send more than three.</p>
{%- capture why -%}You received this because {{ teen.firstName }} gave this address as their {{ guardian.relationLabel | downcase }}'s email.{%- endcapture -%}
{% include "mailer/teen/_foot.liquid" %}
