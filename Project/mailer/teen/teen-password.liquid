{%- assign tone = "teen" -%}
{%- assign preheader = "One last thing: create your password and your account switches on." -%}
{%- assign kicker = "Teen Panel registration" -%}
{%- capture title -%}Your {{ guardian.relationLabel | downcase }} said yes, {{ teen.firstName }}!{%- endcapture -%}
{% include "mailer/teen/_head.liquid" %}
<p style="margin:0 0 16px;">Great news. Your {{ guardian.relationLabel | downcase }} gave permission. Create your password and your account switches on.</p>
<table role="presentation" width="100%" border="0" cellspacing="0" cellpadding="0" bgcolor="#f6f0ff" style="background:#f6f0ff;border-radius:12px;margin:0 0 8px;">
  <tr><td style="padding:14px 18px;font-size:14px;line-height:22px;color:#3a2a6b;">Your username: <b style="font-family:'Courier New',Courier,monospace;">{{ teen.email }}</b></td></tr>
</table>
{%- assign btn_url = links.password -%}{%- assign btn_label = "Create my password" -%}{%- assign btn_color = "#7c3aed" -%}
{%- capture btn_note -%}This link works once, until {{ expires | date: "%B %-d, %Y" }}. If it runs out, you can ask for a new one on the page it opens.{%- endcapture -%}
{% include "mailer/teen/_button.liquid" %}
{%- assign why = "You received this because you registered for the Teen Panel with this email address." -%}
{% include "mailer/teen/_foot.liquid" %}
