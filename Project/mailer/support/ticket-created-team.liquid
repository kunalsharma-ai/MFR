<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>New Support Ticket</title>
  </head>
  <body style="margin:0;padding:0;background:#f4f4f4;">
    <table
      width="100%"
      border="0"
      cellspacing="0"
      cellpadding="0"
      bgcolor="#f4f4f4"
      style="margin:0;padding:0;background:#f4f4f4;font-family:Arial,Helvetica,sans-serif;">
      <tr>
        <td align="center">
          <table
            width="920"
            border="0"
            cellspacing="0"
            cellpadding="0"
            bgcolor="#ffffff"
            style="max-width:920px;">

            <tr>
              <td height="12" bgcolor="#002b8f"></td>
            </tr>

            <tr>
              <td align="center" style="padding:30px 20px;background:#ffffff;">
                <img
                  src="https://myfrequentrewards.com/images/logo/mfr-logo.png"
                  alt="MyFrequentRewards"
                  width="520"
                  style="display:block;max-width:100%;" />
              </td>
            </tr>

            <tr>
              <td height="1" bgcolor="#fe7e00"></td>
            </tr>

            <tr>
              <td style="padding:35px 60px 15px;">
                <p style="margin:0 0 25px;font-size:28px;color:#0d2372;font-weight:bold;">New Support Ticket</p>
                <p style="margin:0;font-size:22px;line-height:38px;color:#14245d;">A new support ticket has been created by a MyFrequent<span style="color:#fe7e00;">Rewards</span>
                  panel user. Please review the ticket details below and take the necessary action.</p>
              </td>
            </tr>

            <tr>
              <td style="padding:30px 55px;">
                <table
                  width="100%"
                  border="0"
                  cellspacing="0"
                  cellpadding="0"
                  style="border:1px solid #d7e4ff;border-radius:12px;background:#f8fbff;">

                  <tr>
                    <td colspan="2" style="padding:25px 30px;border-bottom:1px solid #d7e4ff;">
                      <h2 style="margin:0;color:#0d2372;font-size:28px;">Ticket Information</h2>
                    </td>
                  </tr>

                  <tr>
                    <td width="220" style="padding:20px 30px 10px;color:#0d2372;font-size:18px;font-weight:bold;">Name</td>
                    <td style="padding:20px 30px 10px 0;color:#22305f;font-size:18px;">{{ user.name }}</td>
                  </tr>

                  <tr>
                    <td width="220" style="padding:10px 30px;color:#0d2372;font-size:18px;font-weight:bold;">Email</td>
                    <td style="padding:10px 30px 10px 0;color:#22305f;font-size:18px;">{{ user.email }}</td>
                  </tr>

                  <tr>
                    <td width="220" style="padding:10px 30px;color:#0d2372;font-size:18px;font-weight:bold;">Ticket No.</td>
                    <td style="padding:10px 30px 10px 0;color:#22305f;font-size:18px;font-weight:bold;">{{ data.ticketNo }}</td>
                  </tr>

                  <tr>
                    <td width="220" style="padding:10px 30px 20px;color:#0d2372;font-size:18px;font-weight:bold;">Subject</td>
                    <td style="padding:10px 30px 20px 0;color:#22305f;font-size:18px;">{{ data.subject }}</td>
                  </tr>

                </table>
              </td>
            </tr>

            <tr>
              <td style="padding:0 55px 35px;">
                <table
                  width="100%"
                  border="0"
                  cellspacing="0"
                  cellpadding="0"
                  style="background:#fef8f2;border:1px solid #f0d7b4;border-radius:10px;">
                  <tr>
                    <td
                      width="120"
                      align="center"
                      style="padding:25px;">
                      <img
                        src="https://frequentresearch.com/mailer/mail-icons/mfr/mail.png"
                        width="85"
                        alt="Support Ticket"
                        style="display:block;" />
                    </td>
                    <td style="padding:25px 25px 25px 0;">
                      <h3 style="margin:0 0 10px;color:#0d2372;font-size:22px;">Action Required</h3>
                      <p style="margin:0;font-size:18px;line-height:30px;color:#22305f;">Please review the ticket and respond to the panel user as soon as possible. If additional information is required, follow up with the user using the contact details provided above.</p>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            {% include "mailer/footer.liquid" %}
            <tr>
              <td height="10" bgcolor="#fe7e00"></td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>