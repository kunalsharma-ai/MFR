<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Support Ticket Updated</title>
  </head>
  <body style="margin:0;padding:0;background:#f4f4f4;">
    <table
      width="100%"
      border="0"
      cellspacing="0"
      cellpadding="0"
      bgcolor="#f4f4f4"
      style="margin:0;padding:0;background:#f4f4f4;font-family:Arial,Helvetica,sans-serif;">
      <tr>
        <td align="center">
          <table
            width="920"
            border="0"
            cellspacing="0"
            cellpadding="0"
            bgcolor="#ffffff"
            style="max-width:920px;">

            <tr>
              <td height="12" bgcolor="#002b8f"></td>
            </tr>

            <tr>
              <td align="center" style="padding:30px 20px;background:#ffffff;">
                <img
                  src="https://myfrequentrewards.com/images/logo/mfr-logo.png"
                  alt="MyFrequentRewards"
                  width="520"
                  style="display:block;max-width:100%;" />
              </td>
            </tr>

            <tr>
              <td height="1" bgcolor="#fe7e00"></td>
            </tr>

            <tr>
              <td style="padding:35px 60px 15px;">
                <p style="margin:0 0 25px;font-size:28px;color:#0d2372;font-weight:bold;">Support Ticket Updated</p>
                <p style="margin:0;font-size:22px;line-height:38px;color:#14245d;">Support ticket
                  <strong>[{{ reply.ticketNo }}]</strong>
                  has been updated. Please review the latest response and take the necessary action.</p>
              </td>
            </tr>

            <tr>
              <td style="padding:30px 55px;">
                <table
                  width="100%"
                  border="0"
                  cellspacing="0"
                  cellpadding="0"
                  style="border:1px solid #d7e4ff;border-radius:12px;background:#f8fbff;">

                  <tr>
                    <td
                      align="center"
                      width="220"
                      style="padding:30px;">
                      <img
                        src="https://frequentresearch.com/mailer/mail-icons/mfr/mail.png"
                        width="150"
                        alt="Support Ticket"
                        style="display:block;" />
                    </td>

                    <td style="padding:35px 35px 35px 0;">
                      <h2 style="margin:0 0 15px;color:#0d2372;font-size:30px;">Ticket [{{ reply.ticketNo }}]</h2>
                      <p style="margin:0;color:#17285f;font-size:20px;line-height:34px;">A new message has been added to this support ticket.</p>
                    </td>
                  </tr>

                </table>
              </td>
            </tr>

            <tr>
              <td style="padding:0 55px 35px;">
                <table
                  width="100%"
                  border="0"
                  cellspacing="0"
                  cellpadding="0"
                  style="border:1px solid #f0d7b4;border-radius:12px;background:#fef8f2;">

                  <tr>
                    <td style="padding:30px 35px;">
                      <p style="margin:0 0 15px;color:#0d2372;font-size:18px;font-weight:bold;">Latest Ticket Update</p>
                      <div style="color:#22305f;font-size:19px;line-height:32px;">{{ reply.message }}</div>
                    </td>
                  </tr>

                </table>
              </td>
            </tr>

            <tr>
              <td style="padding:0 55px 35px;">
                <table
                  width="100%"
                  border="0"
                  cellspacing="0"
                  cellpadding="0"
                  style="background:#f8fbff;border:1px solid #d7e4ff;border-radius:10px;">

                  <tr>
                    <td
                      width="120"
                      align="center"
                      style="padding:25px;">
                      <img
                        src="https://frequentresearch.com/mailer/mail-icons/mfr/shield.png"
                        width="85"
                        alt="Action Required"
                        style="display:block;" />
                    </td>

                    <td style="padding:25px 25px 25px 0;">
                      <h3 style="margin:0 0 10px;color:#0d2372;font-size:22px;">Action Required</h3>
                      <p style="margin:0;font-size:18px;line-height:30px;color:#22305f;">Please review the latest ticket update and take the appropriate action. If a response is required, update the ticket through the Support Ticket system.</p>
                    </td>
                  </tr>

                </table>
              </td>
            </tr>

            <tr>
              <td style="padding:0 55px 35px;">
                <p style="margin:0;font-size:20px;line-height:34px;color:#14245d;">Please do not reply directly to this email. Any additional information or response should be added through the Support Ticket system.</p>
              </td>
            </tr>
            {% include "mailer/footer.liquid" %}
            <tr>
              <td height="10" bgcolor="#fe7e00"></td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>