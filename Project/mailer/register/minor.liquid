<table
  width="100%"
  border="0"
  cellspacing="0"
  cellpadding="0"
  bgcolor="#f4f4f4"
  style="
    margin: 0;
    padding: 0;
    background: #f4f4f4;
    font-family: Arial, Helvetica, sans-serif;
  "
>
  <tr>
    <td align="center">
      <table
        width="920"
        border="0"
        cellspacing="0"
        cellpadding="0"
        bgcolor="#ffffff"
        style="
          max-width: 920px;
          width: 100%;
          background: #ffffff;
        "
      >
        <!-- Top Brand Bar -->
        <tr>
          <td height="12" bgcolor="#002b8f"></td>
        </tr>

        <!-- Logo -->
        <tr>
          <td
            align="center"
            style="
              padding: 28px 20px 24px;
              background: #ffffff;
            "
          >
            <img
              src="https://myfrequentrewards.com/images/logo/mfr-logo.png"
              alt="MyFrequentRewards"
              width="460"
              style="
                display: block;
                max-width: 100%;
                height: auto;
                border: 0;
              "
            />
          </td>
        </tr>

        <!-- Accent Bar -->
        <tr>
          <td height="3" bgcolor="#fe7e00"></td>
        </tr>

        <!-- Hero -->
        <tr>
          <td
            align="center"
            style="
              padding: 55px 40px 50px;
              background: #f5f8ff;
            "
          >
            <table
              border="0"
              cellspacing="0"
              cellpadding="0"
              align="center"
            >
              <tr>
                <td
                  style="
                    padding: 0 12px;
                    color: #fe7e00;
                    font-size: 28px;
                    font-weight: bold;
                  "
                >
                  •
                </td>
                <td
                  style="
                    padding: 0 12px;
                    color: #002b8f;
                    font-size: 38px;
                    font-weight: bold;
                  "
                >
                  •
                </td>
                <td
                  style="
                    padding: 0 12px;
                    color: #fe7e00;
                    font-size: 24px;
                    font-weight: bold;
                  "
                >
                  •
                </td>
                <td
                  style="
                    padding: 0 12px;
                    color: #002b8f;
                    font-size: 32px;
                    font-weight: bold;
                  "
                >
                  •
                </td>
                <td
                  style="
                    padding: 0 12px;
                    color: #fe7e00;
                    font-size: 26px;
                    font-weight: bold;
                  "
                >
                  •
                </td>
              </tr>
            </table>

            <p
              style="
                margin: 28px 0 8px;
                color: #fe7e00;
                font-size: 18px;
                font-weight: bold;
                letter-spacing: 2px;
                text-transform: uppercase;
              "
            >
              Parental Consent Required
            </p>

            <h1
              style="
                margin: 0;
                color: #0d2372;
                font-size: 42px;
                line-height: 52px;
                font-weight: bold;
              "
            >
              Dear {{user.parent.name.first}},
              <br />
              Your Consent Is Required
            </h1>

            <p
              style="
                margin: 22px auto 0;
                max-width: 680px;
                color: #263565;
                font-size: 20px;
                line-height: 32px;
              "
            >
              Your child has registered with MyFrequentRewards
              and has indicated that they are under the age of 18.
            </p>
          </td>
        </tr>

        <!-- Introduction -->
        <tr>
          <td style="padding: 40px 55px 20px;">
            <table
              width="100%"
              border="0"
              cellspacing="0"
              cellpadding="0"
              style="
                background: #ffffff;
                border: 1px solid #dce5f8;
                border-radius: 16px;
              "
            >
              <tr>
                <!-- Icon Section -->
                <td
                  width="180"
                  align="center"
                  valign="middle"
                  style="
                    padding: 35px 15px;
                    background: #fff7ef;
                    border-radius: 16px 0 0 16px;
                  "
                >
                  <table
                    border="0"
                    cellspacing="0"
                    cellpadding="0"
                    align="center"
                  >
                    <tr>
                      <td
                        align="center"
                        style="
                          color: #fe7e00;
                          font-size: 50px;
                          line-height: 60px;
                          font-weight: bold;
                        "
                      >
                        ✓
                      </td>
                    </tr>

                    <tr>
                      <td
                        align="center"
                        style="
                          padding-top: 8px;
                          color: #002b8f;
                          font-size: 15px;
                          font-weight: bold;
                          letter-spacing: 1px;
                        "
                      >
                        PARENTAL REVIEW
                      </td>
                    </tr>
                  </table>
                </td>

                <!-- Content -->
                <td
                  valign="middle"
                  style="
                    padding: 38px 40px;
                  "
                >
                  <h2
                    style="
                      margin: 0 0 18px;
                      color: #0d2372;
                      font-size: 28px;
                      line-height: 36px;
                    "
                  >
                    About Your Child's Registration
                  </h2>

                  <p
                    style="
                      margin: 0 0 18px;
                      color: #253562;
                      font-size: 17px;
                      line-height: 28px;
                    "
                  >
                    Your child,
                    <strong>{{user.name.first}}</strong>,
                    has registered on
                    <a
                      href="https://{{user.origin}}"
                      target="_blank"
                      style="
                        color: #002b8f;
                        font-weight: bold;
                        text-decoration: none;
                      "
                    >
                      MyFrequentRewards
                    </a>,
                    an online survey and market research panel operated
                    by Frequent Research Fieldwork Solutions Pvt. Ltd.
                  </p>

                  <p
                    style="
                      margin: 0;
                      color: #253562;
                      font-size: 17px;
                      line-height: 28px;
                    "
                  >
                    During registration, your child indicated that they
                    are under the age of 18 and provided your email address
                    as their <strong>{{user.parent.relation}}</strong>.
                  </p>
                </td>
              </tr>
            </table>
          </td>
        </tr>

        <!-- Why Receiving -->
        <tr>
          <td style="padding: 20px 55px 10px;">
            <h2
              style="
                margin: 0 0 12px;
                color: #0d2372;
                font-size: 26px;
                line-height: 36px;
              "
            >
              Why You Are Receiving This Email
            </h2>

            <p
              style="
                margin: 0;
                color: #253562;
                font-size: 17px;
                line-height: 28px;
              "
            >
              In accordance with our Child Protection and Privacy Policy,
              we require verified parental approval before allowing access
              to our platform. We are committed to maintaining a safe and
              secure environment for all participants, especially minors.
            </p>
          </td>
        </tr>

        <!-- What We Collect -->
        <tr>
          <td style="padding: 25px 55px 10px;">
            <table
              width="100%"
              border="0"
              cellspacing="0"
              cellpadding="0"
              style="
                background: #f5f8ff;
                border-radius: 14px;
              "
            >
              <tr>
                <td style="padding: 28px 30px;">
                  <h2
                    style="
                      margin: 0 0 12px;
                      color: #0d2372;
                      font-size: 26px;
                      line-height: 36px;
                    "
                  >
                    What We Collect
                  </h2>

                  <p
                    style="
                      margin: 0 0 12px;
                      color: #253562;
                      font-size: 17px;
                      line-height: 28px;
                    "
                  >
                    With your consent, we may collect:
                  </p>

                  <ul
                    style="
                      margin: 0;
                      padding-left: 22px;
                      color: #253562;
                      font-size: 17px;
                      line-height: 30px;
                    "
                  >
                    <li>Basic profile information such as name, age, and gender</li>
                    <li>Survey participation responses</li>
                    <li>Reward-related details, if applicable</li>
                  </ul>
                </td>
              </tr>
            </table>
          </td>
        </tr>

        <!-- Parent Rights -->
        <tr>
          <td style="padding: 25px 55px 10px;">
            <h2
              style="
                margin: 0 0 12px;
                color: #0d2372;
                font-size: 26px;
                line-height: 36px;
              "
            >
              Your Rights as a Parent or Guardian
            </h2>

            <p
              style="
                margin: 0 0 10px;
                color: #253562;
                font-size: 17px;
                line-height: 28px;
              "
            >
              You have the right to:
            </p>

            <ul
              style="
                margin: 0;
                padding-left: 22px;
                color: #253562;
                font-size: 17px;
                line-height: 30px;
              "
            >
              <li>Review your child's information shared with us</li>
              <li>Withdraw consent at any time</li>
              <li>Request account deletion</li>
              <li>Contact us for any clarification</li>
            </ul>
          </td>
        </tr>

        <!-- Contact CTA -->
        <tr>
          <td style="padding: 25px 55px 35px;">
            <table
              width="100%"
              border="0"
              cellspacing="0"
              cellpadding="0"
              style="
                background: #002b8f;
                border-radius: 16px;
              "
            >
              <tr>
                <td
                  align="center"
                  style="
                    padding: 35px 30px;
                  "
                >
                  <p
                    style="
                      margin: 0 0 10px;
                      color: #fe7e00;
                      font-size: 17px;
                      font-weight: bold;
                      letter-spacing: 1.5px;
                      text-transform: uppercase;
                    "
                  >
                    We're Here to Help
                  </p>

                  <h2
                    style="
                      margin: 0 0 14px;
                      color: #ffffff;
                      font-size: 30px;
                      line-height: 40px;
                    "
                  >
                    Have Questions?
                  </h2>

                  <p
                    style="
                      margin: 0 auto 20px;
                      max-width: 650px;
                      color: #dce7ff;
                      font-size: 17px;
                      line-height: 28px;
                    "
                  >
                    For assistance, clarification, or any request regarding
                    your child's account, please contact us.
                  </p>

                  <a
                    href="mailto:support@{{user.origin}}"
                    style="
                      display: inline-block;
                      background: #fe7e00;
                      color: #ffffff;
                      text-decoration: none;
                      padding: 14px 38px;
                      border-radius: 10px;
                      font-size: 17px;
                      font-weight: bold;
                    "
                  >
                    CONTACT SUPPORT
                  </a>
                </td>
              </tr>
            </table>
          </td>
        </tr>

        <!-- Closing -->
        <tr>
          <td
            align="center"
            style="
              padding: 15px 60px 40px;
            "
          >
            <table
              border="0"
              cellspacing="0"
              cellpadding="0"
              align="center"
            >
              <tr>
                <td
                  height="3"
                  width="55"
                  bgcolor="#fe7e00"
                ></td>

                <td width="15"></td>

                <td
                  height="3"
                  width="55"
                  bgcolor="#002b8f"
                ></td>
              </tr>
            </table>

            <p
              style="
                margin: 20px 0 0;
                color: #0d2372;
                font-size: 19px;
                line-height: 30px;
                font-weight: bold;
              "
            >
              Thank you for helping us maintain a safe and
              responsible research environment.
            </p>
          </td>
        </tr>

        <!-- Footer -->
        <tr>
          <td>
            {% include "mailer/footer.liquid" %}
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
