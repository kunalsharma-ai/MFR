<table
  width="100%"
  border="0"
  cellspacing="0"
  cellpadding="0"
  bgcolor="#f4f4f4"
  style="
    margin: 0;
    padding: 0;
    background: #f4f4f4;
    font-family: Arial, Helvetica, sans-serif;
  "
>
  <tr>
    <td align="center">
      <table
        width="920"
        border="0"
        cellspacing="0"
        cellpadding="0"
        bgcolor="#ffffff"
        style="max-width: 920px"
      >
        <!-- TOP BORDER -->
        <tr>
          <td height="12" bgcolor="#002b8f"></td>
        </tr>

        <!-- LOGO SECTION -->
        <tr>
          <td align="center" style="padding: 30px 20px; background: #ffffff">
            <img
              src="https://myfrequentrewards.com/images/logo/mfr-logo.png"
              alt="MyFrequentRewards"
              width="520"
              style="display: block; max-width: 100%"
            />
          </td>
        </tr>
<tr>
          <td height="1" bgcolor="#fe7e00"></td>
        </tr>
    

        <!-- INTRO -->
        <tr>
          <td style="padding: 35px 60px 15px">
            <p
              style="
                margin: 0 0 25px;
                font-size: 28px;
                color: #0d2372;
                font-weight: bold;
              "
            >
              Hi {{user.name.first}},
            </p>

            <p
              style="
                margin: 0;
                font-size: 22px;
                line-height: 38px;
                color: #14245d;
              "
            >
             We received a request to reset your password for your MyFrequent<span
                      style="color: #fe7e00"
                      >Rewards</span
                    > panel account.
            </p>
          </td>
        </tr>

        <!-- VERIFY CARD -->
        <tr>
          <td style="padding: 30px 55px">
            <table
              width="100%"
              border="0"
              cellspacing="0"
              cellpadding="0"
              style="
                border: 1px solid #f0d7b4;
                border-radius: 12px;
                background: #fef8f2;
              "
            >
              <tr>
                <td width="220" align="center">
                  <img src="https://frequentresearch.com/mailer/mail-icons/mfr/mail.png" width="180" alt="Verify" />
                </td>

                <td style="padding: 35px 35px 35px 0">
                  <h2 style="margin: 0 0 15px; color: #0d2372; font-size: 30px">
                    Reset Your Account Password
                  </h2>

                  <p
                    style="
                      margin: 0 0 30px;
                      color: #17285f;
                      font-size: 20px;
                      line-height: 34px;
                    "
                  >
                 If you've made this request, please click the link below to set a new password:
                  </p>

                  <a
                   href="http://{{user.origin}}/auth/password?user={{user._id}}&code={{otp.code}}"
                    style="
                      display: inline-block;
                      background: #fe7e00;
                      color: #ffffff;
                      text-decoration: none;
                      padding: 18px 40px;
                      border-radius: 12px;
                      font-size: 18px;
                      font-weight: bold;
                    "
                  >
                    RESET PASSWORD
                  </a>
                </td>
              </tr>
            </table>
          </td>
        </tr>
        <!-- SECURITY NOTICE -->
        <tr>
          <td style="padding: 0 55px 35px">
            <table
              width="100%"
              style="
                background: #f8fbff;
                border: 1px solid #d7e4ff;
                border-radius: 10px;
              "
            >
              <tr>
                <td width="120" align="center" style="padding: 25px">
                  <img src="https://frequentresearch.com/mailer/mail-icons/mfr/shield.png" width="85" />
                </td>

                <td style="padding: 25px 25px 25px 0">
                  <h3 style="margin: 0 0 10px; color: #0d2372; font-size: 22px">
                    Didn't Request?
                  </h3>

                  <p
                    style="
                      margin: 0;
                      font-size: 18px;
                      line-height: 30px;
                      color: #22305f;
                    "
                  >
                  If you did not request a password reset for the MyFrequent<span
                      style="color: #fe7e00"
                      >Rewards</span
                    >
                    Panel account,<br />
                    please ignore this message. No further action is required.
                  </p>
                </td>
              </tr>
            </table>
          </td>
        </tr>

        <tr>
          <td
            style="
              padding: 15px 55px;
              border-top: 1px solid #ddd;
              border-bottom: 1px solid #ddd;
            "
          >
            <table width="100%">
              <tr>
                <td align="center" style="padding: 8px">
                  <img
                    src="https://frequentresearch.com/mailer/icons/phone.png"
                    alt="Phone"
                    width="30"
                    height="30"
                    style="border: 0; display: block; margin-bottom: 8px"
                  />
                  <a
                    href="tel:+919810459700"
                    style="color: #000; text-decoration: none"
                    >+91 98104 59700</a
                  >
                </td>

                <td
                  align="center"
                  style="padding: 8px; border-left: 2px solid #ddd"
                >
                  <img
                    src="https://frequentresearch.com/mailer/icons/email.png"
                    alt="Email"
                    width="30"
                    height="30"
                    style="border: 0; display: block; margin-bottom: 8px"
                  />
                  <a
                    href="mailto:support@myfrequentrewards.com"
                    style="color: #000; text-decoration: none"
                    >support@myfrequentrewards.com</a
                  >
                </td>

                <td
                  align="center"
                  style="padding: 8px; border-left: 2px solid #ddd"
                >
                  <img
                    src="https://frequentresearch.com/mailer/icons/internet.png"
                    alt="Website"
                    width="30"
                    height="30"
                    style="border: 0; display: block; margin-bottom: 8px"
                  />
                  <a
                    href="https://www.myfrequentrewards.com"
                    style="color: #000; text-decoration: none"
                    >www.myfrequentrewards.com</a
                  >
                </td>
              </tr>
            </table>
          </td>
        </tr>

        <!-- TEAM -->
        <tr>
          <td align="center" style="padding: 35px 20px 20px">
            <p style="margin: 0; color: #333; font-size: 18px">With Regards,</p>

            <p
              style="
                margin: 10px 0;
                color: #0d2372;
                font-size: 34px;
                font-weight: bold;
              "
            >
              My Frequent Rewards Team
            </p>

            <p style="margin: 0; color: #666; font-size: 22px">
              A Frequent Research Survey Panel
            </p>
          </td>
        </tr>
        <tr>
          <td align="center">
            <table
              role="presentation"
              cellspacing="0"
              cellpadding="0"
              border="0"
            >
              <tr>
                <td width="60" height="2" bgcolor="#fe7e00"></td>
              </tr>
            </table>
          </td>
        </tr>
        <!-- SOCIAL -->
        <tr>
          <td align="center" style="padding: 30px 20px 50px">
            <a
              href="https://www.linkedin.com/company/my-frequent-rewards"
              style="
                text-decoration: none;
                display: inline-block;
                color: #ffffff;
                vertical-align: middle;
                margin-left: 10px;
              "
            >
              <img
                src="https://frequentresearch.com/mailer/icons/linkedin.png"
                alt="Linkedin"
                width="30"
                height="30"
                style="
                  border: 0;
                  display: inline-block;
                  vertical-align: middle;
                  margin-right: 8px;
                "
              />
            </a>

            <a
              href="https://www.facebook.com/FrequentResearchFieldwork/"
              style="
                text-decoration: none;
                display: inline-block;
                color: #ffffff;
                vertical-align: middle;
                margin-left: 10px;
              "
            >
              <img
                src="https://frequentresearch.com/mailer/icons/facebook.png"
                alt="Facebook"
                width="30"
                height="30"
                style="
                  border: 0;
                  display: inline-block;
                  vertical-align: middle;
                  margin-right: 8px;
                "
              />
            </a>

            <a
              href="https://twitter.com/frequentrfs/"
              style="
                text-decoration: none;
                display: inline-block;
                color: #ffffff;
                vertical-align: middle;
                margin-left: 10px;
              "
            >
              <img
                src="https://frequentresearch.com/mailer/icons/twitter.png"
                alt="Twitter/X"
                width="30"
                height="30"
                style="
                  border: 0;
                  display: inline-block;
                  vertical-align: middle;
                  margin-right: 8px;
                "
              />
            </a>
          </td>
        </tr>

        <!-- BOTTOM BAR -->
        <tr>
          <td height="10" bgcolor="#fe7e00"></td>
        </tr>
      </table>
    </td>
  </tr>
</table>
