<table
  width="100%"
  border="0"
  cellspacing="0"
  cellpadding="0"
  bgcolor="#f4f4f4"
  style="
    margin: 0;
    padding: 0;
    background: #f4f4f4;
    font-family: Arial, Helvetica, sans-serif;
  ">
  <tr>
    <td align="center">
      <table
        width="920"
        border="0"
        cellspacing="0"
        cellpadding="0"
        bgcolor="#ffffff"
        style="
          max-width: 920px;
          width: 100%;
          background: #ffffff;
        ">
        <!-- Top Brand Bar -->
        <tr>
          <td height="12" bgcolor="#002b8f"></td>
        </tr>

        <!-- Logo -->
        <tr>
          <td align="center" style="
              padding: 28px 20px 24px;
              background: #ffffff;
            ">
            <img
              src="https://myfrequentrewards.com/images/logo/mfr-logo.png"
              alt="MyFrequentRewards"
              width="460"
              style="
                display: block;
                max-width: 100%;
                height: auto;
                border: 0;
              " />
          </td>
        </tr>

        <!-- Accent Bar -->
        <tr>
          <td height="3" bgcolor="#fe7e00"></td>
        </tr>

        <!-- Hero -->
        <tr>
          <td align="center" style="
              padding: 55px 40px 50px;
              background: #f5f8ff;
            ">
            <table
              border="0"
              cellspacing="0"
              cellpadding="0"
              align="center">
              <tr>
                <td style="
                    padding: 0 12px;
                    color: #fe7e00;
                    font-size: 28px;
                    font-weight: bold;
                  ">
                  •
                </td>
                <td style="
                    padding: 0 12px;
                    color: #002b8f;
                    font-size: 38px;
                    font-weight: bold;
                  ">
                  •
                </td>
                <td style="
                    padding: 0 12px;
                    color: #fe7e00;
                    font-size: 24px;
                    font-weight: bold;
                  ">
                  •
                </td>
                <td style="
                    padding: 0 12px;
                    color: #002b8f;
                    font-size: 32px;
                    font-weight: bold;
                  ">
                  •
                </td>
                <td style="
                    padding: 0 12px;
                    color: #fe7e00;
                    font-size: 26px;
                    font-weight: bold;
                  ">
                  •
                </td>
              </tr>
            </table>

            <p style="
                margin: 28px 0 8px;
                color: #fe7e00;
                font-size: 18px;
                font-weight: bold;
                letter-spacing: 2px;
                text-transform: uppercase;
              ">
              Welcome to MyFrequentRewards
            </p>

            <h1 style="
                margin: 0;
                color: #0d2372;
                font-size: 42px;
                line-height: 52px;
                font-weight: bold;
              ">
              Your Account Is Active
              <br/>
              Welcome to the Panel!
            </h1>

            <p style="
                margin: 22px auto 0;
                max-width: 680px;
                color: #263565;
                font-size: 20px;
                line-height: 32px;
              ">
              Your password has been successfully created, 
              and your MyFrequentRewards Panel Community account is now active.
            </p>
          </td>
        </tr>

        <!-- Account Status -->
        <tr>
          <td style="padding: 40px 55px 20px;">
            <table
              width="100%"
              border="0"
              cellspacing="0"
              cellpadding="0"
              style="
                background: #ffffff;
                border: 1px solid #dce5f8;
                border-radius: 16px;
              ">
              <tr>
                <!-- Icon Section -->
                <td
                  width="180"
                  align="center"
                  valign="middle"
                  style="
                    padding: 35px 15px;
                    background: #fff7ef;
                    border-radius: 16px 0 0 16px;
                  ">
                  <table
                    border="0"
                    cellspacing="0"
                    cellpadding="0"
                    align="center">
                    <tr>
                      <td align="center" style="
                          color: #fe7e00;
                          font-size: 52px;
                          line-height: 60px;
                          font-weight: bold;
                        ">
                        ✓
                      </td>
                    </tr>

                    <tr>
                      <td align="center" style="
                          padding-top: 8px;
                          color: #002b8f;
                          font-size: 15px;
                          font-weight: bold;
                          letter-spacing: 1px;
                        ">
                        ACCOUNT ACTIVE
                      </td>
                    </tr>
                  </table>
                </td>

                <!-- Content -->
                <td valign="middle" style="
                    padding: 38px 40px;
                  ">
                  <h2 style="
                      margin: 0 0 18px;
                      color: #0d2372;
                      font-size: 28px;
                      line-height: 36px;
                    ">
                    You're All Set!
                  </h2>

                  <p style="
                      margin: 0 0 18px;
                      color: #253562;
                      font-size: 17px;
                      line-height: 28px;
                    ">
                    Your MyFrequentRewards account is now active. 
                    You can log in to your dashboard and complete your
                    profile to get started.
                  </p>

                  <p style="
                      margin: 0;
                      color: #253562;
                      font-size: 17px;
                      line-height: 28px;
                    ">
                    Once your profile is complete, you can start 
                    participating in healthcare market research studies
                    tailored to your profile and earn rewards for
                    sharing your valuable opinions.
                  </p>
                </td>
              </tr>
            </table>
          </td>
        </tr>

        <!-- Login CTA -->
        <tr>
          <td style="padding: 20px 55px 35px;">
            <table
              width="100%"
              border="0"
              cellspacing="0"
              cellpadding="0"
              style="
                background: #002b8f;
                border-radius: 16px;
              ">
              <tr>
                <td align="center" style="
                    padding: 38px 35px;
                  ">
                  <p style="
                      margin: 0 0 10px;
                      color: #fe7e00;
                      font-size: 17px;
                      font-weight: bold;
                      letter-spacing: 1.5px;
                      text-transform: uppercase;
                    ">
                    Get Started
                  </p>

                  <h2 style="
                      margin: 0 0 14px;
                      color: #ffffff;
                      font-size: 30px;
                      line-height: 40px;
                    ">
                    Ready to Share Your Insights?
                  </h2>

                  <p style="
                      margin: 0 auto 25px;
                      max-width: 650px;
                      color: #dce7ff;
                      font-size: 17px;
                      line-height: 28px;
                    ">
                    Log in to your dashboard, update your profile, 
                    and discover research opportunities matched to you.
                  </p>

                  <a
                    href="https://{{user.origin}}/?login"
                    target="_blank"
                    style="
                      display: inline-block;
                      background: #fe7e00;
                      color: #ffffff;
                      text-decoration: none;
                      padding: 15px 40px;
                      border-radius: 10px;
                      font-size: 17px;
                      font-weight: bold;
                    ">
                    LOGIN TO YOUR ACCOUNT
                  </a>
                </td>
              </tr>
            </table>
          </td>
        </tr>

        <!-- Closing -->
        <tr>
          <td align="center" style="
              padding: 15px 60px 40px;
            ">
            <table
              border="0"
              cellspacing="0"
              cellpadding="0"
              align="center">
              <tr>
                <td
                  height="3"
                  width="55"
                  bgcolor="#fe7e00"></td>

                <td width="15"></td>

                <td
                  height="3"
                  width="55"
                  bgcolor="#002b8f"></td>
              </tr>
            </table>

            <p style="
                margin: 20px 0 0;
                color: #0d2372;
                font-size: 20px;
                line-height: 32px;
                font-weight: bold;
              ">
              We look forward to your valuable participation and insights.
            </p>

            <p style="
                margin: 10px 0 0;
                color: #53627f;
                font-size: 15px;
                line-height: 24px;
              ">
              Thank you for being part of the MyFrequentRewards 
              Panel Community.
            </p>
          </td>
        </tr>

        <!-- Footer -->
        <tr>
          <td>
            {% include "mailer/footer.liquid" %}
          </td>
        </tr>
        <tr>
          <td height="10" bgcolor="#fe7e00"></td>
        </tr>
      </table>
    </td>
  </tr>
</table>