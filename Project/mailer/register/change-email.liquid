<table
  width="100%"
  border="0"
  cellspacing="0"
  cellpadding="0"
  bgcolor="#f4f4f4"
  style="
    margin: 0;
    padding: 0;
    background: #f4f4f4;
    font-family: Arial, Helvetica, sans-serif;
  ">
  <tr>
    <td align="center">
      <table
        width="920"
        border="0"
        cellspacing="0"
        cellpadding="0"
        bgcolor="#ffffff"
        style="
          max-width: 920px;
          width: 100%;
          background: #ffffff;
        ">
        <!-- Top Brand Bar -->
        <tr>
          <td height="12" bgcolor="#002b8f"></td>
        </tr>

        <!-- Logo -->
        <tr>
          <td align="center" style="
              padding: 28px 20px 24px;
              background: #ffffff;
            ">
            <img
              src="https://myfrequentrewards.com/images/logo/mfr-logo.png"
              alt="MyFrequentRewards"
              width="460"
              style="
                display: block;
                max-width: 100%;
                height: auto;
                border: 0;
              " />
          </td>
        </tr>

        <!-- Accent Bar -->
        <tr>
          <td height="3" bgcolor="#fe7e00"></td>
        </tr>

        <!-- Hero -->
        <tr>
          <td align="center" style="
              padding: 55px 40px 50px;
              background: #f5f8ff;
            ">
            <table
              border="0"
              cellspacing="0"
              cellpadding="0"
              align="center">
              <tr>
                <td style="
                    padding: 0 12px;
                    color: #fe7e00;
                    font-size: 28px;
                    font-weight: bold;
                  ">
                  •
                </td>
                <td style="
                    padding: 0 12px;
                    color: #002b8f;
                    font-size: 38px;
                    font-weight: bold;
                  ">
                  •
                </td>
                <td style="
                    padding: 0 12px;
                    color: #fe7e00;
                    font-size: 24px;
                    font-weight: bold;
                  ">
                  •
                </td>
                <td style="
                    padding: 0 12px;
                    color: #002b8f;
                    font-size: 32px;
                    font-weight: bold;
                  ">
                  •
                </td>
                <td style="
                    padding: 0 12px;
                    color: #fe7e00;
                    font-size: 26px;
                    font-weight: bold;
                  ">
                  •
                </td>
              </tr>
            </table>

            <p style="
                margin: 28px 0 8px;
                color: #fe7e00;
                font-size: 18px;
                font-weight: bold;
                letter-spacing: 2px;
                text-transform: uppercase;
              ">
              Email Change Request
            </p>

            <h1 style="
                margin: 0;
                color: #0d2372;
                font-size: 42px;
                line-height: 52px;
                font-weight: bold;
              ">
              Hey {{ user.name.first }}!
              <br/>
              Verify Your New Email
            </h1>

            <p style="
                margin: 22px auto 0;
                max-width: 680px;
                color: #263565;
                font-size: 20px;
                line-height: 32px;
              ">
              We received a request to change the email address  
              associated with your MyFrequentRewards account.
            </p>
          </td>
        </tr>

        <!-- Request Details -->
        <tr>
          <td style="padding: 40px 55px 20px;">
            <table
              width="100%"
              border="0"
              cellspacing="0"
              cellpadding="0"
              style="
                background: #ffffff;
                border: 1px solid #dce5f8;
                border-radius: 16px;
              ">
              <tr>
                <td
                  width="180"
                  align="center"
                  valign="middle"
                  style="
                    padding: 35px 15px;
                    background: #fff7ef;
                    border-radius: 16px 0 0 16px;
                  ">
                  <table
                    border="0"
                    cellspacing="0"
                    cellpadding="0"
                    align="center">
                    <tr>
                      <td align="center" style="
                          color: #fe7e00;
                          font-size: 54px;
                          line-height: 60px;
                          font-weight: bold;
                        ">
                        @
                      </td>
                    </tr>

                    <tr>
                      <td align="center" style="
                          padding-top: 8px;
                          color: #002b8f;
                          font-size: 16px;
                          font-weight: bold;
                          letter-spacing: 1px;
                        ">
                        ACCOUNT SECURITY
                      </td>
                    </tr>
                  </table>
                </td>

                <td valign="middle" style="
                    padding: 38px 40px;
                  ">
                  <h2 style="
                      margin: 0 0 18px;
                      color: #0d2372;
                      font-size: 28px;
                      line-height: 36px;
                    ">
                    Confirm Your Email Change
                  </h2>

                  <p style="
                      margin: 0 0 18px;
                      color: #253562;
                      font-size: 17px;
                      line-height: 28px;
                    ">
                    Your registered email will be changed from
                    <strong>{{ user.mail }}</strong>
                    to
                    <strong>{{ email }}</strong>.
                  </p>

                  <p style="
                      margin: 0;
                      color: #253562;
                      font-size: 17px;
                      line-height: 28px;
                    ">
                    To complete the process, click the button below.  
                    The verification link is valid for
                    <strong style="color: #fe7e00;">24 hours</strong>.
                  </p>
                </td>
              </tr>
            </table>
          </td>
        </tr>

        <!-- Verification CTA -->
        <tr>
          <td style="padding: 20px 55px 35px;">
            <table
              width="100%"
              border="0"
              cellspacing="0"
              cellpadding="0"
              style="
                background: #002b8f;
                border-radius: 16px;
              ">
              <tr>
                <td align="center" style="
                    padding: 38px 35px;
                  ">
                  <p style="
                      margin: 0 0 10px;
                      color: #fe7e00;
                      font-size: 17px;
                      font-weight: bold;
                      letter-spacing: 1.5px;
                      text-transform: uppercase;
                    ">
                    Secure Your Account
                  </p>

                  <h2 style="
                      margin: 0 0 14px;
                      color: #ffffff;
                      font-size: 30px;
                      line-height: 40px;
                    ">
                    Confirm your new email address
                  </h2>

                  <p style="
                      margin: 0 auto 25px;
                      max-width: 650px;
                      color: #dce7ff;
                      font-size: 17px;
                      line-height: 28px;
                    ">
                    Please verify this request to complete the  
                    email address change on your account.
                  </p>

                  <a
                    href="https://{{user.origin}}/auth/change-email?confcode={{token}}"
                    target="_blank"
                    style="
                      display: inline-block;
                      background: #fe7e00;
                      color: #ffffff;
                      text-decoration: none;
                      padding: 15px 40px;
                      border-radius: 10px;
                      font-size: 17px;
                      font-weight: bold;
                    ">
                    VERIFY EMAIL
                  </a>
                </td>
              </tr>
            </table>
          </td>
        </tr>

        <!-- Security Notice -->
        <tr>
          <td align="center" style="
              padding: 15px 60px 40px;
            ">
            <table
              border="0"
              cellspacing="0"
              cellpadding="0"
              align="center">
              <tr>
                <td
                  height="3"
                  width="55"
                  bgcolor="#fe7e00"></td>

                <td width="15"></td>

                <td
                  height="3"
                  width="55"
                  bgcolor="#002b8f"></td>
              </tr>
            </table>

            <p style="
                margin: 20px 0 0;
                color: #0d2372;
                font-size: 20px;
                line-height: 32px;
                font-weight: bold;
                font-style: italic;
              ">
              If you did not request this change, please ignore this email.
            </p>

          </td>
        </tr>

        <!-- Footer -->
        <tr>
          <td>
            {% include "mailer/footer.liquid" %}
          </td>
        </tr>
        <tr>
          <td height="10" bgcolor="#fe7e00"></td>
        </tr>
      </table>
    </td>
  </tr>
</table>